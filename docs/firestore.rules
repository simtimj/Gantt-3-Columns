// Firestore security rules for the Gantt app (2026-11-22, docs/NOTES.md → H3, H4).
// Paste into Firebase console → Firestore → Rules → Publish.
// Only Julius's Google account can read or write. "Newest edit wins": an update must carry a newer `at`
// (saved-at ms) than the stored copy, so an old offline edit can't overwrite a newer one; the app then saves
// the losing copy to ganttBackup, which the Sheet mirror moves into the Backup tab.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function me() {
      return request.auth != null
        && request.auth.token.email == 'juliussimtim@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /gantt/{doc} {
      allow read: if me();
      allow create: if me() && request.resource.data.at is int;
      allow update: if me() && request.resource.data.at is int && request.resource.data.at > resource.data.at;
      allow delete: if false;
    }
    // Days (H4): doc per day. Newest wins per section: every section an update changes (tasks, journal, plan,
    // tho) must carry a newer <section>At than the stored one; untouched sections can't be changed.
    function newer(f) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f, f + 'At'])
        || (request.resource.data[f + 'At'] is int && request.resource.data[f + 'At'] > resource.data.get(f + 'At', 0));
    }
    match /ganttDays/{day} {
      allow read: if me();
      allow create: if me() && request.resource.data.date == day && request.resource.data.at is int;
      allow update: if me() && request.resource.data.date == day && request.resource.data.at is int
        && newer('tasks') && newer('journal') && newer('plan') && newer('tho');
      allow delete: if false;
    }
    // Reference (H5 C, 2026-11-23): doc per card; a deleted card keeps its doc with del set (= the Archive).
    // Newest wins per card: an update must carry a newer `at`. Cards are never removed from the database.
    match /ganttRef/{card} {
      allow read: if me();
      allow create: if me() && request.resource.data.id == card && request.resource.data.at is int;
      allow update: if me() && request.resource.data.id == resource.data.id && request.resource.data.at is int
        && request.resource.data.at > resource.data.at;
      allow delete: if false;
    }
    // Calendar copy (H5 B2, 2026-11-23): written only by the server (it reads Google Calendar); the app just reads.
    match /ganttCal/{doc} {
      allow read: if me();
      allow write: if false;
    }
    match /ganttBackup/{id} {
      allow create: if me();
      allow read, update, delete: if false;
    }
  }
}
